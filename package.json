{
  "name": "@thomascaron/opale-ui",
  "version": "3.2.0",
  "private": true,
  "description": "Opale — le socle UI commun de portfolio et travels_in_world : jetons mesures, contrat de couleur executable, composants verre liquide.",
  "author": "Thomas Caron",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/magic/index.d.ts",
      "import": "./dist/magic/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./tokens.css": "./dist/tokens/tokens.css",
    "./opale.css": "./dist/magic/magic.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:lib": "rm -rf dist && tsc -p tsconfig.lib.json && npm run build:css && npm run build:magic",
    "build:css": "rm -rf dist/tokens && mkdir -p dist/tokens && cp src/tokens/*.css dist/tokens/",
    "build:magic": "rm -rf dist/magic && tsc -p tsconfig.magic.json && vite build --config vite.magic.config.ts",
    "prepare": "npm run build:lib",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "hack-font": "^3.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.86.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
